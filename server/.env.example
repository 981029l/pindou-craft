# # 拼豆工坊自建独立后端环境配置文件
# # 复制此文件为 .env 即可生效：cp .env.example .env

# 服务端口
PORT=3001

# JWT 鉴权密钥 (请修改为随机复杂字符串)
JWT_SECRET=pindou_atelier_jwt_secret_key_2026

# 微信小程序凭证 (用于换取真实 openid；未配置时将使用游客模式/模拟openid，开发环境可直接使用)
WECHAT_APPID=
WECHAT_APPSECRET=

# 图片上传存储目录
UPLOAD_DIR=./uploads

# 服务器公网访问基准地址 (用于生成图片访问 URL，例如 https://api.yourdomain.com 或 http://IP:3001)
BASE_URL=http://localhost:3001
