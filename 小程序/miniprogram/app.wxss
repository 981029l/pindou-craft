/* # 拼豆工坊全局样式 - 多巴胺手作轻奢视觉体系 */
@import "./styles/icons.wxss";

page {
  background-color: #F8F6F0;
  color: #1C1917;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
}

/* # 极简拟物工坊卡片 */
.artisan-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  border: 1rpx solid rgba(231, 229, 228, 0.9);
  box-shadow: 0 8rpx 30rpx rgba(120, 113, 108, 0.06);
  padding: 28rpx;
  margin-bottom: 24rpx;
}

/* # 琥珀流光主操作按键 */
.btn-glow-primary {
  background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
  color: #FFFFFF;
  font-weight: bold;
  font-size: 30rpx;
  border-radius: 999rpx;
  box-shadow: 0 10rpx 28rpx rgba(245, 158, 11, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0;
  border: none;
  letter-spacing: 1rpx;
  transition: transform 0.1s, opacity 0.1s;
}

.btn-glow-primary:active {
  transform: scale(0.98);
  opacity: 0.92;
}

/* # 次级操作按键胶囊 */
.btn-dock-pill {
  background: #FFFFFF;
  color: #292524;
  font-weight: 600;
  font-size: 26rpx;
  border-radius: 999rpx;
  border: 1rpx solid #E7E5E4;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  margin: 0;
}

.btn-dock-pill:active {
  background: #F5F5F4;
  transform: scale(0.98);
}

/* # 隐藏滚动条 */
::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}
