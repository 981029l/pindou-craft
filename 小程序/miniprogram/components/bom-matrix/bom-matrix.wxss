/* # 双拼用料矩阵样式 - 极简手作卡片 */
.bom-container {
  background: #FAFAF9;
  border-radius: 24rpx;
  padding: 20rpx;
  border: 1rpx solid #E7E5E4;
  margin-top: 16rpx;
}

.bom-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid #E7E5E4;
}

.title-wrap {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.title {
  font-size: 26rpx;
  font-weight: 800;
  color: #1C1917;
}

.sub-title {
  font-size: 20rpx;
  font-family: monospace;
  font-weight: 700;
  color: #78716C;
}

.tip-text {
  font-size: 20rpx;
  color: #A8A29E;
}

.clear-btn {
  background: #F59E0B;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: bold;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 8rpx rgba(245, 158, 11, 0.3);
}

.chips-scroll {
  max-height: 220rpx;
}

.chips-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

/* # 双拼拼接胶囊 */
.chip-item {
  display: flex;
  align-items: center;
  border-radius: 12rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  overflow: hidden;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.1s;
}

.chip-item:active {
  transform: scale(0.95);
}

.chip-item.highlighted {
  border-color: #F59E0B;
  box-shadow: 0 0 0 3rpx rgba(245, 158, 11, 0.4);
}

.chip-color {
  padding: 6rpx 12rpx;
  font-family: monospace;
  font-weight: 800;
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 52rpx;
}

.chip-count {
  background: #FFFFFF;
  padding: 6rpx 10rpx;
  font-family: monospace;
  font-weight: 800;
  font-size: 20rpx;
  color: #44403C;
  border-left: 1rpx solid rgba(0, 0, 0, 0.06);
}
