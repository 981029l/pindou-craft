<!-- # 双拼用料胶囊矩阵组件 -->
<view class="bom-container">
  <view class="bom-header">
    <view class="title-wrap">
      <text class="title">用料清单</text>
      <text class="sub-title">共 {{totalCount}} 颗 · {{colorList.length}} 色</text>
    </view>
    <view wx:if="{{highlightCode}}" class="clear-btn" bindtap="onClearHighlight">
      <text>高亮: [{{highlightCode}}] 点击还原</text>
    </view>
    <view wx:else class="tip-text">
      <text>点击色卡一键高亮找色</text>
    </view>
  </view>

  <!-- # 胶囊矩阵横向/多行排列 -->
  <scroll-view scroll-y class="chips-scroll">
    <view class="chips-grid">
      <view 
        wx:for="{{colorList}}" 
        wx:key="code" 
        class="chip-item {{highlightCode === item.code ? 'highlighted' : ''}}"
        bindtap="onSelectChip"
        data-code="{{item.code}}"
      >
        <!-- # 左侧色块色号 -->
        <view class="chip-color" style="background-color: {{item.hex}}; color: {{item.textColor}};">
          <text class="chip-code">{{item.code}}</text>
        </view>
        <!-- # 右侧白底颗数 -->
        <view class="chip-count">
          <text>{{item.count}}</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
