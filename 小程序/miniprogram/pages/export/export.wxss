/* # 导出页面样式 - 多巴胺手作轻奢 */
@import "../../styles/icons.wxss";

.export-container {
  padding: 24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
}

.card-headline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F5F5F4;
}

.headline-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.headline-icon {
  font-size: 28rpx;
}

.headline-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #1C1917;
}

.headline-hint {
  font-size: 22rpx;
  color: #A8A29E;
  font-weight: 500;
}

.headline-stats {
  display: flex;
  gap: 8rpx;
}

.stat-badge {
  background: #FEF3C7;
  color: #92400E;
  font-size: 20rpx;
  font-weight: bold;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.preview-wrap {
  width: 100%;
  height: 480rpx;
  background: #ECEAE5;
  border-radius: 20rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #E7E5E4;
}

.export-canvas {
  width: 100%;
  height: 100%;
}

.bom-table {
  background: #FAFAF9;
  border: 1rpx solid #E7E5E4;
  border-radius: 20rpx;
  overflow: hidden;
}

.bom-table-header {
  display: flex;
  background: #F5F5F4;
  padding: 16rpx 20rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #78716C;
  border-bottom: 1rpx solid #E7E5E4;
}

.bom-table-scroll {
  max-height: 380rpx;
}

.bom-table-row {
  display: flex;
  align-items: center;
  padding: 14rpx 20rpx;
  border-bottom: 1rpx solid #F5F5F4;
  font-size: 24rpx;
}

.th-code, .td-code {
  width: 120rpx;
  font-family: monospace;
  font-weight: 800;
  color: #1C1917;
}

.th-name, .td-name {
  flex: 1;
  color: #44403C;
  font-weight: 600;
}

.th-color, .td-color {
  width: 100rpx;
  display: flex;
  justify-content: center;
}

.color-sample {
  width: 32rpx;
  height: 32rpx;
  border-radius: 8rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.1);
}

.th-count, .td-count {
  width: 140rpx;
  text-align: right;
  font-family: monospace;
  font-weight: 800;
  color: #B45309;
}
