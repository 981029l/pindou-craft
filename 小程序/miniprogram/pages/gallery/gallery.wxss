/* # 作品集页面样式 - 多巴胺手作轻奢 */
@import "../../styles/icons.wxss";

.gallery-container {
  padding: 24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
}

.gallery-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}

.gallery-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #1C1917;
}

.gallery-count {
  font-size: 24rpx;
  font-weight: 700;
  color: #78716C;
}

.project-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.project-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  border: 1rpx solid rgba(231, 229, 228, 0.9);
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.project-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.project-name {
  font-size: 28rpx;
  font-weight: 800;
  color: #1C1917;
}

.project-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.meta-tag {
  background: #FEF3C7;
  color: #92400E;
  font-size: 20rpx;
  font-family: monospace;
  font-weight: 800;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.meta-date {
  font-size: 20rpx;
  color: #A8A29E;
}

.project-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.btn-load {
  background: #F59E0B;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 800;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 12rpx rgba(245, 158, 11, 0.3);
  margin: 0;
}

.btn-delete {
  background: #F5F5F4;
  color: #DC2626;
  font-size: 22rpx;
  font-weight: bold;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  margin: 0;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 140rpx 40rpx;
  text-align: center;
}

.empty-icon-circle {
  width: 128rpx;
  height: 128rpx;
  border-radius: 999rpx;
  background: #FFFBEB;
  border: 2rpx solid #FEF3C7;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 28rpx rgba(245, 158, 11, 0.15);
}

.empty-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #1C1917;
  letter-spacing: -0.5rpx;
  margin-bottom: 14rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #78716C;
  line-height: 1.6;
  max-width: 520rpx;
  margin-bottom: 36rpx;
}

.empty-action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 800;
  padding: 16rpx 40rpx;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 20rpx rgba(245, 158, 11, 0.35);
  cursor: pointer;
  transition: all 0.15s ease;
}

.empty-action-btn:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 10rpx rgba(245, 158, 11, 0.25);
}
